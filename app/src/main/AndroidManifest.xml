<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fairuman.filemanager"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Shizuku：访问根目录用的 shell 权限（API_V23 是 Shizuku 管理应用定义的权限）。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_app_icon"
        android:roundIcon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Fairumanaja">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection|orientation|screenSize" />
        <!-- v1.9.4 开屏动画：SplashActivity 做启动页（LAUNCHER），播完才进
             主界面；noHistory 保证返回键不会回到开屏页。 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Fairumanaja">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Fairumanaja" />
        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:theme="@style/Theme.Fairumanaja"
            android:parentActivityName=".SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SettingsActivity" />
        </activity>
        <activity
            android:name=".LanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.Fairumanaja" />
        <activity
            android:name=".ExperimentalActivity"
            android:exported="false"
            android:theme="@style/Theme.Fairumanaja"
            android:parentActivityName=".SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SettingsActivity" />
        </activity>
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Fairumanaja" />
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:theme="@style/Theme.Fairumanaja" />
        <activity
            android:name=".TextEditorActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:theme="@style/Theme.Fairumanaja" />
        <provider
            android:name=".FairuFileProvider"
            android:authorities="com.fairuman.filemanager.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Shizuku：客户端用来接收 Shizuku 服务 binder 的 provider。
             直连打包没有 manifest 合并，所以 authorities 直接写死包名
             （等价于 ${applicationId}.shizuku）。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.fairuman.filemanager.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>
