<?xml version="1.0" encoding="utf-8"?>
<!-- v1.8.0：每行末尾的 ⋮ 菜单按钮加回来了（Max 要求；v1.7.0 去掉是为了
     名字占满整行，名字还是 15sp 单行完整显示，⋮ 只占 40dp）；
     多选模式下 ⋮ 藏起来，改显示圆形勾选框（选中为蓝色实心圆 + 白对勾，
     照 Max 发的参考图）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- v1.9.4：照 MP-Manager 的行样式——小圆角方图标（30dp，圆角 6dp，
         见 FileAdapter.setTile），不再是大圆；名字 13sp。 -->
    <ImageView
        android:id="@+id/iconView"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/file"
        android:padding="6dp"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <!-- v1.9.4（Max 22:02 纠正）：名字最多五行——两行不行就三行、四行、
             五行，长名必须完整显示，一个字都不许截、不许省略号。
             固定 13sp，ellipsize 关掉，换行显示全名。
             autoSize 已彻底去掉（v1.9.1 教训：复用会带偏字号）。 -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="5"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <!-- v1.9.4：副标题改成“日期 + 大小”（MP 样式，如 26-09-13 10:04 1.61MB）。
             一行完整显示：窄窗格里 12sp 放不下时按 autoSize 缩到 8sp，
             ellipsize 关掉，不许用 … 截断；bindInfo 里每次先复位到 12sp，
             避免 RecyclerView 复用把上一行的缩小字号带过来。 -->
        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <!-- 多选模式下的圆形勾选框（选中为蓝色实心圆 + 白对勾，代码里画；
         平时隐藏，⋮ 按钮显示）。无障碍读屏不读它（它是行选中态的
         纯视觉标记，行名本身会被读出；以前错写成 @string/select_all，
         会把每行勾选框都读成“全选”）。 -->
    <ImageView
        android:id="@+id/checkView"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- v1.9.0 Pin folder：置顶的文件夹行末尾显示图钉标记（平时隐藏）。 -->
    <ImageView
        android:id="@+id/pinView"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pin"
        android:visibility="gone"
        app:tint="?attr/colorPrimary" />

    <!-- 每行末尾的 ⋮：点它弹出该项的操作菜单（打开/分享/复制/剪切/
         删除/重命名/属性）。着色用 colorControlNormal，浅色下也看得见。 -->
    <ImageButton
        android:id="@+id/moreBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:src="@drawable/ic_more_vert"
        app:tint="?attr/colorControlNormal" />
</LinearLayout>
