<?xml version="1.0" encoding="utf-8"?>
<!-- 多语言设置页（简单版 1.3.0）：选语言只打勾，不立即切换；
     点右上角 ✓ 确认才切换，直接返回则不切换。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/languageToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/fairuToolbarBackground"
        app:titleTextColor="?attr/fairuToolbarTitleColor"
        app:navigationIconTint="?attr/fairuToolbarTitleColor"
        app:menu="@menu/language_menu"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/language_settings" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languageList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />
</LinearLayout>
