<?xml version="1.0" encoding="utf-8"?>
<!-- 全新简单版 1.2.0：双窗格（MT 式）+ 左上角抽屉菜单。
     根布局是 DrawerLayout：主内容 + 左侧滑出的抽屉（本地 / 工具两组）。 -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- v1.9.6 液态玻璃：工具栏包在 LiquidGlassView 里（QWEA0/Liquid-Glass-Android）。
             玻璃关着时由代码把它配成透明容器（见 MainActivity.setupLiquidGlass），
             外观与原来一模一样；开着时工具栏背景改透明，玻璃本身做底。 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerRadius="0dp"
            app:glassMaterial="regular">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/fairuToolbarBackground"
            app:titleTextColor="?attr/fairuToolbarTitleColor"
            app:subtitleTextColor="?attr/fairuToolbarTitleColor"
            app:navigationIconTint="?attr/fairuToolbarTitleColor"
            app:title="@string/app_name" />
        </com.example.liquidglass.LiquidGlassView>

        <!-- v1.8.0 多选模式顶栏（照 Max 发的参考图）：平时隐藏，选中后
             顶替掉上面的工具栏——✕ 退出多选，中间“已选择 N 项”+ 已选总大小，
             右边分享 / 删除 / ⋮。底部的选择操作条删了，不再两套并存。 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassSelectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerRadius="0dp"
            app:glassMaterial="regular">

        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorControlNormal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/selTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/selSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSelShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/btnSelDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:src="@drawable/ic_drawer_trash"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/btnSelMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>
        </com.example.liquidglass.LiquidGlassView>

        <LinearLayout
            android:id="@+id/panesRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/paneLeft"
                layout="@layout/pane_file_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <View
                android:id="@+id/paneDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/colorOutlineVariant" />

            <include
                android:id="@+id/paneRight"
                layout="@layout/pane_file_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 底部：返回 < / 前进 > / 新建 + / 交换 ⇄ / 上一级 ↑（针对当前活动窗格） -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerRadius="0dp"
            app:glassMaterial="regular">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurfaceContainerHigh"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/back"
                app:icon="@drawable/ic_arrow_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForward"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/forward"
                app:icon="@drawable/ic_arrow_forward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNew"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/new_folder"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwap"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/swap_panes"
                app:icon="@drawable/ic_swap" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/go_up"
                app:icon="@drawable/ic_arrow_up" />
        </LinearLayout>
        </com.example.liquidglass.LiquidGlassView>
    </LinearLayout>

    <!-- 左侧抽屉：本地（根目录 / 内部储存，带储存用量条）+ 工具（回收站 / 文本编辑器 / 设置） -->
    <FrameLayout
        android:id="@+id/drawerView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface">

        <!-- v1.9.6 液态玻璃：抽屉内容包在 LiquidGlassView 里，背景是后面的主内容
             （backdropSource 由代码指到 mainRoot）。玻璃关着时配成透明容器。 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassDrawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="0dp"
            app:glassMaterial="regular">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <ImageButton
                    android:id="@+id/drawerOverflow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more_options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </LinearLayout>

            <TextView
                android:id="@+id/drawerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/drawerLocalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/drawer_local"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:id="@+id/drawerRootRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_drawer_root"
                        app:tint="?attr/colorControlNormal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drawerRootLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_directory"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <ProgressBar
                            android:id="@+id/drawerRootBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/drawerRootInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerInternalRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_drawer_storage"
                        app:tint="?attr/colorControlNormal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drawerInternalLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_internal"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <ProgressBar
                            android:id="@+id/drawerInternalBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/drawerInternalInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 自定义本地储存（用户自己加的目录）：由代码动态往里加行 -->
                <LinearLayout
                    android:id="@+id/drawerCustomContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- v1.9.0 书签分组（没有书签时整个分组隐藏，由代码控制）。 -->
                <TextView
                    android:id="@+id/drawerBookmarksTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/bookmarks_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/drawerBookmarksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/drawerToolsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/drawer_tools"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:id="@+id/drawerTrashRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_drawer_trash"
                        app:tint="?attr/colorControlNormal" />

                    <TextView
                        android:id="@+id/drawerTrashLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trash"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerEditorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_drawer_editor"
                        app:tint="?attr/colorControlNormal" />

                    <TextView
                        android:id="@+id/drawerEditorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_editor"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerSettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_drawer_settings"
                        app:tint="?attr/colorControlNormal" />

                    <TextView
                        android:id="@+id/drawerSettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        </LinearLayout>
        </com.example.liquidglass.LiquidGlassView>
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
