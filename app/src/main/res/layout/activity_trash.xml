<?xml version="1.0" encoding="utf-8"?>
<!-- 回收站（v1.2.0）：列表 + 底部清空按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/trashToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/fairuToolbarBackground"
        app:titleTextColor="?attr/fairuToolbarTitleColor"
        app:navigationIconTint="?attr/fairuToolbarTitleColor"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/trash" />

    <!-- v1.9.0 选择模式顶栏（图8，但没有分享）：✕ / 已选择 N 项+大小 /
         删除 / 恢复 / ⋮（⋮ 里只有全选）。平时隐藏。 -->
    <LinearLayout
        android:id="@+id/trashSelectionTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnTrashSelClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorControlNormal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/trashSelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/trashSelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTrashSelDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_drawer_trash"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnTrashSelRestore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/restore"
            android:src="@drawable/ic_undo"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnTrashSelMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trashList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/trashEmptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/trash_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyTrash"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/empty_trash"
        app:icon="@drawable/ic_drawer_trash" />
</LinearLayout>
